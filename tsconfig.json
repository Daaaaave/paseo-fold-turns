{
  "compilerOptions": {
    "target": "ES2023", "lib": ["ES2023"], "module": "NodeNext", "moduleResolution": "NodeNext",
    "strict": true, "noEmit": true, "allowImportingTsExtensions": true,
    "jsx": "react-jsx", "skipLibCheck": true, "types": ["node", "react"]
  },
  "include": ["index.*.ts", "index.*.tsx", "client/**/*.ts", "client/**/*.tsx", "shared/**/*.ts", "server/**/*.ts", "tests/**/*.ts"]
}
